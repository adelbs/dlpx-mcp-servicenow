# Copy this file to .env for local development (never commit the real .env).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# dxi-mcp-server (https://github.com/delphix/dxi-mcp-server) is installed as
# a project dependency (`uv sync`) and spawned directly as a stdio
# subprocess by app/mcp_client.py — no separate service to run. These are
# the same DCT credentials it uses to call the DCT REST API.
DCT_BASE_URL=https://my-dct-instance.example.com
DCT_API_KEY=

SERVICENOW_INSTANCE_URL=https://dev424996.service-now.com
SERVICENOW_USER=delphix.orchestrator
SERVICENOW_PASSWORD=
