# Copy this file to .env for local development (never commit the real .env).

# Default "ollama" — local, no per-call cost, needs `ollama serve` running
# locally with the model below pulled (see docs/architecture.md for
# model/hardware sizing guidance). Set to "anthropic" to use the Claude API
# instead (small per-call cost, more reliable extraction).
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only used when LLM_PROVIDER=ollama. Must support tool calling.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# dxi-mcp-server (https://github.com/delphix/dxi-mcp-server) is installed as
# a project dependency (`uv sync`) and spawned directly as a stdio
# subprocess by app/mcp_client.py — no separate service to run. These are
# the same DCT credentials it uses to call the DCT REST API.
DCT_BASE_URL=https://my-dct-instance.example.com
DCT_API_KEY=

SERVICENOW_INSTANCE_URL=https://dev424996.service-now.com
SERVICENOW_USER=delphix.orchestrator
SERVICENOW_PASSWORD=
