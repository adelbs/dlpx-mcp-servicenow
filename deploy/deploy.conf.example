# Copy this file to deploy/deploy.conf and fill in the values.
# deploy/deploy.conf is gitignored (contains secrets) — never commit the real file.
#
# Normally you don't need to edit this file manually: running ./orchestrator.sh
# and choosing "Install" for the first time, the menu asks for these values
# interactively and creates deploy/deploy.conf for you.

# SSH connection to the CentOS server this orchestrator will be installed on.
SSH_HOST="my-server.example.com"
SSH_USER="root"
SSH_PORT="22"

# This orchestrator owns its own Nginx vhost and Let's Encrypt certificate
# (see docs/architecture.md). DOMAIN must already have a DNS A/AAAA record
# pointing at SSH_HOST, and ports 80/443 must be reachable from the internet
# (install_prereqs.sh opens them in firewalld; a cloud security group in
# front of this host, if any, is separate and must allow them too).
DOMAIN="my-server.example.com"
LETSENCRYPT_EMAIL="you@example.com"

# Which backend extracts the affected app + timestamp from the incident
# text: "anthropic" (Claude API, small per-call cost) or "ollama" (runs
# fully locally on this same server via install_prereqs.sh's Ollama install
# — no per-call cost, needs enough free RAM for the chosen model; see
# docs/architecture.md for model/hardware sizing guidance).
LLM_PROVIDER="anthropic"

# Only used when LLM_PROVIDER="anthropic".
ANTHROPIC_API_KEY="change-me"
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Only used when LLM_PROVIDER="ollama". Must support tool calling
# (llama3.2/qwen2.5 do). "llama3.2:3b" is the recommended default on modest
# hardware (~3GB RAM once loaded) — see docs/architecture.md before picking
# a bigger one.
OLLAMA_MODEL="llama3.2:3b"

# Delphix DCT credentials. dxi-mcp-server (https://github.com/delphix/dxi-mcp-server,
# installed as a project dependency and spawned directly as a stdio
# subprocess by app/mcp_client.py) uses these to call the DCT REST API on
# this orchestrator's behalf.
DCT_BASE_URL="https://my-dct-instance.example.com"
DCT_API_KEY="change-me"

# ServiceNow PDI credentials (delphix.orchestrator service user, role itil).
SERVICENOW_INSTANCE_URL="https://dev424996.service-now.com"
SERVICENOW_USER="delphix.orchestrator"
SERVICENOW_PASSWORD="change-me"
