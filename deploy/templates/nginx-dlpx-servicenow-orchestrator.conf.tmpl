# Rendered by deploy/remote/setup_nginx.sh, then handed to `certbot --nginx`
# which edits this same file in place to add the "listen 443 ssl" block,
# certificate paths, and an HTTP->HTTPS redirect. Re-rendered from this
# plain-HTTP template on every install (deliberately — see setup_nginx.sh),
# so this file should only ever contain the plain-HTTP starting point.
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    location /servicenow-webhook {
        proxy_pass http://127.0.0.1:8940/servicenow-webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The app holds this request open for the LLM extraction call plus
        # the ENTIRE Delphix provision/teardown job — app/delphix_client.py's
        # poll_job() only returns once the job reaches a terminal state, up
        # to JOB_POLL_TIMEOUT_SECONDS (900s by default; see app/config.py).
        # Nginx's stock 60s proxy_read_timeout would 504 well before that —
        # and before a slow local LLM call finishes too (Ollama on CPU-only
        # hardware can take well over a minute — see docs/architecture.md).
        # Keep this comfortably above JOB_POLL_TIMEOUT_SECONDS if that's ever
        # tuned higher in .env/orchestrator.env.
        proxy_connect_timeout 10s;
        proxy_send_timeout 970s;
        proxy_read_timeout 970s;
    }

    location /health {
        proxy_pass http://127.0.0.1:8940/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
