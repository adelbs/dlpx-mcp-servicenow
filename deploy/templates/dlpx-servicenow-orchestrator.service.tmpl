[Unit]
Description=dlpx-servicenow-orchestrator - Delphix <-> ServiceNow incident-driven VDB orchestrator
# dxi-mcp-server (dct-mcp-server) is spawned directly by this app itself
# (app/mcp_client.py) as a stdio subprocess, not a separate systemd unit —
# no external MCP service to order against.
After=network.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{SERVICE_HOME}}
EnvironmentFile={{ETC_DIR}}/orchestrator.env
ExecStart={{SERVICE_HOME}}/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8940
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
